# IA SONO — variables d'environnement du serveur Render
NODE_ENV=production
PORT=3000

# URL publique exacte du service Render (HTTPS, sans chemin)
PUBLIC_APP_URL=https://VOTRE-SERVICE.onrender.com
CLIENT_URL=https://VOTRE-SERVICE.onrender.com

# Supabase — projet Winner / izisono uniquement
SUPABASE_URL=https://cezxykekfgoflwszzkwb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Génération musicale IA
MUREKA_API_KEY=
MUREKA_MODEL=auto

# LomoPay Direct API — clés provenant de l'espace API LomoPay
LOMOPAY_PUBLIC_KEY=pk_test_REMPLACER
LOMOPAY_SECRET_KEY=sk_test_REMPLACER

# Garder XOF tant que les autres devises ne sont pas explicitement activées sur le compte LomoPay
LOMOPAY_ENABLED_CURRENCIES=XOF

# Remplacer les codes opérateur par les identifiants EXACTS fournis par LomoPay.
# Ne jamais laisser les valeurs d'exemple actives.
LOMOPAY_COUNTRY_OPERATORS_JSON={"TG":[{"code":"CODE_TOGOCEL_FOURNI_PAR_LOMOPAY","name":"T-Money","short":"T-Money","icon":"📱"},{"code":"CODE_MOOV_FOURNI_PAR_LOMOPAY","name":"Moov Money","short":"Moov Money","icon":"📲"}]}
