# IZISONO — variables d'environnement
# Remplace les valeurs vides par tes clés de production sur le serveur.
NODE_ENV=production
PORT=3000
CLIENT_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mureka — génération musicale IA (voix / instrumental)
MUREKA_API_KEY=
MUREKA_MODEL=auto

# PayDunya — paiement XOF / FCFA
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# Optionnel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
