# IA SONO — variables d'environnement du serveur Render
NODE_ENV=production
PORT=3000

# URL publique exacte du service Render (HTTPS, sans chemin)
PUBLIC_APP_URL=https://iasono.onrender.com
CLIENT_URL=https://iasono.onrender.com

# Supabase — projet IA SONO uniquement
SUPABASE_URL=https://cezxykekfgoflwszzkwb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Génération musicale IA
MUREKA_API_KEY=
MUREKA_MODEL=auto

# PayDunya — SoftPay (T-Money et Moov Money au Togo)
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
